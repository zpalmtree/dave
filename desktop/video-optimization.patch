+def experiment_input_identity(args: argparse.Namespace) -> dict[str, Any]:
+    def digest(path: Path | None) -> str | None:
+        return hashlib.sha256(path.read_bytes()).hexdigest() if path else None
+    return {
+        "generator_sha256": digest(Path(__file__)),
+        "template_sha256": {name: digest(TEMPLATE_DIR / name) for name in ("h3_t2v.json", "h3_i2v.json")},
+        "plan_sha256": digest(args.frontier_plan),
+        "raw_prompt": args.prompt,
+        "seed": args.seed,
+        "aspect": nearest_aspect(args.image) if args.aspect == "auto" else args.aspect,
+        "requested_duration": args.duration,
+        "image_sha256": digest(args.image),
+        "segment_image_sha256": {str(index): digest(path) for index, path in sorted(args.segment_keyframe)},
+    }
+
+
+def validate_experiment_inputs(args: argparse.Namespace) -> dict[str, Any] | None:
+    if args.experiment_contract is None:
+        return None
+    contract = json.loads(args.experiment_contract.read_text(encoding="utf-8"))
+    if contract.get("schema_version") != 1 or contract.get("inputs") != experiment_input_identity(args):
+        raise VideoGenError("Renderer experiment input/code fingerprint changed; prepare a new comparison")
+    if not isinstance(contract.get("compiled_h3"), list) or not contract["compiled_h3"]:
+        raise VideoGenError("Renderer experiment has no frozen compiled scenes")
+    return contract
+
+
+def validate_experiment_compilation(contract: dict[str, Any] | None, compiled: list[dict[str, Any]]) -> None:
+    if contract is not None and compiled != contract["compiled_h3"]:
+        raise VideoGenError("Renderer experiment changed compiled scenes, prompts or frame counts; refusing inference")
+
+
