+def experiment_input_identity(args: argparse.Namespace) -> dict[str, Any]:
+    def digest(path: Path | None) -> str | None:
+        return hashlib.sha256(path.read_bytes()).hexdigest() if path else None
+    return {
+        "generator_sha256": digest(Path(__file__)),
+        "template_sha256": {name: digest(TEMPLATE_DIR / name) for name in ("h3_t2v.json", "h3_i2v.json")},
+        "plan_sha256": digest(args.frontier_plan),
+        "raw_prompt": args.prompt,
+        "seed": args.seed,
+        "aspect": nearest_aspect(args.image) if args.aspect == "auto" else args.aspect,
+        "requested_duration": args.duration,
+        "image_sha256": digest(args.image),
+        "segment_image_sha256": {str(index): digest(path) for index, path in sorted(args.segment_keyframe)},
+    }
