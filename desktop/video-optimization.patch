+def video_prompt_content_numbers(raw_prompt: str, requested_duration: float | None) -> list[str]:
+    """Total runtime belongs in timing fields; other numbers remain scene requirements."""
+    content = raw_prompt
+    if requested_duration is not None:
+        text = re.sub(r"[‐‑‒–—]", "-", raw_prompt)
+        text = re.sub(r'''"[^"\n]*"|“[^”\n]*”|(?<!\w)'[^'\n]*'(?!\w)''',
+                      lambda match: " " * len(match[0]), text)
+        amount = r"(\d+(?:\.\d+)?)"
+        unit = r"(seconds?|secs?|minutes?|mins?)"
+        patterns = [
+            rf"\b(?:make|keep)\s+(?:it|(?:the|this)\s+(?:video|clip|animation|film|short))\s+(?:exactly\s+)?{amount}\s*{unit}\b",
+            rf"\b(?:total(?:\s+(?:video\s+)?)?(?:duration|runtime|length)|duration|runtime|length)\s*(?:of|=|:|is|be)?\s*{amount}\s*{unit}\b",
+            rf"\b(?:video|clip|animation|timelapse|film|sequence|montage|short)\s+(?:with\s+)?(?:a\s+)?(?:total\s+)?(?:duration|runtime|length)?\s*(?:of|=|:|is|be|lasting|lasts|should\s+be|must\s+be)?\s*{amount}\s*{unit}\b",
+            rf"\b{amount}\s*{unit}\s*(?:long|in\s+total|total|overall)\b",
+        ]
+        matches = [match for pattern in patterns if (match := re.search(pattern, text, re.IGNORECASE))]
+        if not matches:
+            for match in re.finditer(rf"\b{amount}\s*(?:-\s*)?{unit}\b", text, re.IGNORECASE):
+                after = text[match.end():match.end() + 100]
+                media = re.search(r"\b(?:video|clip|animation|timelapse|film|sequence|montage|short)\b", after, re.IGNORECASE)
+                if not media:
+                    continue
+                bridge = after[:media.start()]
+                if re.search(r"\b(?:then|after|before|followed|pause|wait|hold)\b", bridge, re.IGNORECASE) or re.search(rf"\b{amount}\s*(?:-\s*)?{unit}\b", bridge, re.IGNORECASE):
+                    continue
+                matches.append(match)
+                break
+        if matches:
+            match = matches[0]
+            seconds = float(match[1]) * (60 if match[2].lower().startswith("min") else 1)
+            if abs(seconds - requested_duration) < 1e-6:
+                start, end = match.span(1)
+                content = raw_prompt[:start] + " " * (end - start) + raw_prompt[end:]
+    return list(dict.fromkeys(re.findall(r"\b\d+(?:\.\d+)?\b", content)))
 
 
