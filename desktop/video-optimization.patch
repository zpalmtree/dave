+def validate_experiment_inputs(args: argparse.Namespace) -> dict[str, Any] | None:
+    if args.experiment_contract is None:
+        return None
+    contract = json.loads(args.experiment_contract.read_text(encoding="utf-8"))
+    if contract.get("schema_version") != 1 or contract.get("inputs") != experiment_input_identity(args):
+        raise VideoGenError("Renderer experiment input/code fingerprint changed; prepare a new comparison")
+    if not isinstance(contract.get("compiled_h3"), list) or not contract["compiled_h3"]:
+        raise VideoGenError("Renderer experiment has no frozen compiled scenes")
+    return contract
+
