+    def test_recovery_uploads_metrics_for_each_scene(self):
+        worker = self.exercise(continuation=True)
+        worker.upload_metrics.assert_awaited_once()
+        job_id, metrics = worker.upload_metrics.await_args.args
+        self.assertEqual(job_id, 'test-job')
+        self.assertEqual(metrics['output']['segment_count'], 2)
+        self.assertGreater(metrics['output']['duration_seconds'], 0)
+        self.assertGreater(metrics['output']['bytes'], 0)
+        self.assertGreater(metrics['total_seconds'], 0)
+        self.assertEqual([(span['segment_index'], span['name']) for span in metrics['spans']
+                          if span['name'].startswith('generator_attempt_')],
+                         [(0, 'generator_attempt_1'), (1, 'generator_attempt_1')])
+        self.assertEqual([span['segment_index'] for span in metrics['spans']
+                          if span['name'] == 'sampling_progress'], [0, 1])
+
+    def test_telemetry_outage_does_not_block_video_delivery(self):
