+class SceneGpuReservation:
+    """Keep ready scenes together; yield the GPU after a bounded preparation gap."""
+    def __init__(self, worker, idle_seconds=15.0):
+        self.worker = worker
+        self.idle_seconds = idle_seconds
+        self.lock = asyncio.Lock()
+        self.idle_task = None
+        self.error = None
+        self.owned = False
+
+    async def _stop_idle_locked(self):
+        task, self.idle_task = self.idle_task, None
+        if task is not None:
+            task.cancel()
+            await asyncio.gather(task, return_exceptions=True)
+
+    async def stop_idle(self):
+        # If expiry already started releasing, wait for it to finish. Never
+        # cancel half of a release or let it race the next render/terminal event.
+        async with self.lock:
+            await self._stop_idle_locked()
+
+    def _check_error(self):
+        if self.error is not None:
+            raise RuntimeError('Could not release the idle GPU reservation') from self.error
+
+    async def acquire(self, job):
+        async with self.lock:
+            await self._stop_idle_locked()
+            self._check_error()
+            if self.worker.cancel_reason:
+                raise asyncio.CancelledError()
+            admitted = await self.worker.ensure_gpu_reservation(job)
+            self.owned = admitted
+            return admitted
+
+    async def _release_locked(self):
+        if self.owned:
+            await release_recovery_reservation(self.worker)
+            self.owned = False
+
+    async def release(self):
+        async with self.lock:
+            await self._stop_idle_locked()
+            self._check_error()
+            await self._release_locked()
+
+    def idle(self):
+        if self.owned:
+            if self.idle_task is not None:
+                raise RuntimeError('GPU idle grace is already running')
+            self.idle_task = asyncio.create_task(self._expire())
+
+    async def _expire(self):
+        await asyncio.sleep(self.idle_seconds)
+        async with self.lock:
+            try:
+                await self._release_locked()
+            except Exception as error:
+                # Surface this in the foreground before another command or
+                # delivery; the normal failure path then cancels the lease.
+                self.error = error
 
 
