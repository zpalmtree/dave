+class HaloTests(unittest.TestCase):
+    def fixture(self):
+        mask = np.zeros((120, 160), np.uint8); mask[40:85, 35:80] = 255
+        source = np.full((120, 160, 3), [80, 90, 110], np.float32)
+        rendered = np.full_like(source, [100, 80, 85])
+        source[mask > 0] = [240, 120, 20]  # different original subject; never colour evidence
+        rendered[mask > 0] = [160, 80, 60]
+        return source, rendered, mask
+
+    def test_original_blurred_fringe_is_erased_before_feathering(self):
+        mask = np.zeros((194, 176), np.uint8); mask[50:140, 30:90] = 255
+        alpha = composite_alpha(mask, mask, [0, 0, 176, 194])
+        # A brown fringe six pixels outside the hard mask was previously blended
+        # back into the frame. It must now receive only the generated background.
+        self.assertEqual(alpha[90, 95], 255)
+        self.assertEqual(alpha[90, 110], 0)
+        self.assertEqual(source_blur_padding([0, 0, 176, 194]), 10)
+        self.assertLessEqual(source_blur_padding([0, 0, 2000, 2000]), 12)
+
+    def test_background_tint_is_reduced_without_changing_face_interior(self):
+        source, rendered, mask = self.fixture()
+        matched, _ = match_edge_background(source, rendered, mask, mask)
+        sample = (55, 100)
+        self.assertLess(np.linalg.norm(matched[sample]-source[sample]),
+                        np.linalg.norm(rendered[sample]-source[sample]) * 0.2)
+        np.testing.assert_array_equal(matched[50:75, 45:70], rendered[50:75, 45:70])
+
+    def test_source_blur_is_excluded_from_colour_samples(self):
+        from scipy.ndimage import binary_dilation
+        source, rendered, mask = self.fixture()
+        blurred = binary_dilation(mask > 0, iterations=source_blur_padding([0, 0, 160, 120]))
+        changed = source.copy(); changed[blurred] = [0, 255, 0]
+        clean, _ = match_edge_background(source, rendered, mask, mask)
+        contaminated, _ = match_edge_background(changed, rendered, mask, mask)
+        np.testing.assert_allclose(clean, contaminated)
+
+    def test_no_background_evidence_clears_history_instead_of_guessing(self):
+        source, rendered, _ = self.fixture()
+        full = np.full((120, 160), 255, np.uint8)
+        result, state = match_edge_background(source, rendered, full, full, np.ones_like(rendered))
+        np.testing.assert_array_equal(result, rendered)
+        self.assertIsNone(state)
+
+    def test_correction_is_bounded_and_temporally_smoothed(self):
+        source, rendered, mask = self.fixture()
+        _, first = match_edge_background(source, rendered, mask, mask)
+        changed = source.copy(); changed[mask == 0] = 255
+        _, direct = match_edge_background(changed, rendered, mask, mask)
+        _, carried = match_edge_background(changed, rendered, mask, mask, first)
+        self.assertLessEqual(np.abs(direct).max(), 38)
+        self.assertLess(np.mean(np.abs(carried-first)), np.mean(np.abs(direct-first)))
+
