+def match_edge_background(source, rendered, source_mask, replacement_mask, previous=None):
+    """Match nearby clean background colour; keep the replacement's interior intact.
+
+    Inputs are one crop in RGB 0..255 and its two masks. The returned state belongs
+    to this segment only. No original subject pixels may supply the colour fit.
+    """
+    source = np.asarray(source, dtype=np.float32)
+    rendered = np.asarray(rendered, dtype=np.float32)
+    if source.shape != rendered.shape or source.ndim != 3 or source.shape[2] != 3:
+        raise ValueError('Edge matching requires equal RGB crops.')
+    height, width = source.shape[:2]
+    if source_mask.shape != (height, width) or replacement_mask.shape != (height, width):
+        raise ValueError('Edge matching masks do not match the crop.')
+    original = source_mask > 127
+    replacement = replacement_mask > 127
+    if not (original | replacement).any():
+        return rendered, None
+    covered = binary_dilation(original, iterations=source_blur_padding([0, 0, width, height])) | replacement
+    distance = distance_transform_edt(~covered)
+    samples = (distance >= 3) & (distance <= 16)
+    if np.count_nonzero(samples) < 64:
+        return rendered, None
+    # A local RGB fit addresses a coloured halo that whole-crop luma matching
+    # cannot fix. Ignore the old subject AND its blur when estimating residuals.
+    weights = gaussian_filter(samples.astype(np.float32), 8)
+    residual = (source - rendered) * samples[:, :, None]
+    field = gaussian_filter(residual, (8, 8, 0)) / np.maximum(weights[:, :, None], 0.0001)
+    field[weights < 0.01] = 0
+    field = np.clip(field, -38, 38)
+    if previous is not None:
+        if previous.shape != field.shape:
+            raise ValueError('Edge matching state belongs to another crop.')
+        field = 0.75 * previous + 0.25 * field
+    # Fade the correction through the antialiased boundary, never through facial
+    # detail in the interior. The alpha compositor still controls the final scope.
+    protected = binary_erosion(replacement, iterations=2, border_value=1)
+    edge = np.clip(distance_transform_edt(~protected) / 6, 0, 1)
+    edge = edge * edge * (3 - 2 * edge)
+    return np.clip(rendered + field * edge[:, :, None], 0, 255), field
