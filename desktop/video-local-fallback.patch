+def review_recovery_artifact(payload: dict[str, Any]) -> dict[str, Any]:
+    """Judge a recovery artifact with local Qwen when the frontier reviewer will not."""
+    def encoded(value: Any) -> str:
+        text = str(value)
+        return text.split(",", 1)[1] if text.startswith("data:") else text
+
+    references = [encoded(value) for value in payload.get("references") or []]
+    frames = [encoded(value) for value in payload.get("frames") or []]
+    if not frames:
+        raise VideoGenError("a recovery review needs artifact frames")
+    response = planner_json("/api/chat", {
+        "model": PROMPT_INTENT_MODEL,
+        "messages": [
+            {"role": "system", "content": RECOVERY_REVIEW_INSTRUCTION},
+            {
+                "role": "user",
+                "content": (
+                    f"The first {len(references)} image(s) are references and the last {len(frames)} "
+                    "are artifact frames.\n"
+                    + json.dumps(payload.get("context") or {}, ensure_ascii=False)
+                ),
+                "images": [*references, *frames],
+            },
+        ],
+        "format": RECOVERY_REVIEW_SCHEMA,
+        "stream": False,
+        "think": False,
+        "keep_alive": "5m",
+        "options": {"temperature": 0.0, "seed": 0, "num_predict": 1200},
+    }, timeout=420.0)
+    try:
+        verdict = json.loads(response.get("message", {}).get("content", ""))
+        acceptable = verdict["acceptable"]
+        issues = verdict["issues"]
+        if not isinstance(acceptable, bool) or not isinstance(issues, list):
+            raise ValueError("acceptable must be a boolean and issues an array")
+    except (KeyError, TypeError, ValueError) as exc:
+        raise VideoGenError(f"local recovery review returned invalid JSON: {exc}") from exc
+    issues = [str(issue).strip() for issue in issues if str(issue).strip()][:8]
+    if not acceptable and not issues:
+        issues = ["The local reviewer rejected the artifact without naming a repairable issue."]
+    return {"acceptable": acceptable, "issues": issues}
+
