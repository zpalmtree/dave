+def generate_recovery_keyframe(server: str, spec: dict[str, Any], seed: int, timeout_seconds: float, steps: int) -> Path:
+    """Compose a recovery scene's opening locally after the image providers declined it."""
+    prompt = str(spec.get("prompt") or "").strip()
+    if not prompt:
+        raise VideoGenError("a recovery opening image needs a prompt")
+    references = [Path(value) for value in spec.get("references") or []]
+    motion = spec.get("motion_contract") if isinstance(spec.get("motion_contract"), dict) else {}
+    fields = ("subject_orientation", "gaze_direction", "travel_direction", "camera_relation", "first_second_action")
+    if not all(str(motion.get(field) or "").strip() for field in fields):
+        motion = {}
+    aspect_image = Path(spec["aspect_image"]) if spec.get("aspect_image") else None
+    aspect = nearest_aspect(aspect_image if aspect_image and aspect_image.is_file() else None)
+    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
+    run_root = OUTPUT_DIR / "video" / "recovery_openings" / f"{timestamp}_{uuid.uuid4().hex[:6]}"
+    return generate_keyframe(server, prompt, motion, aspect, seed, run_root, timeout_seconds, steps,
+                             references=references)
