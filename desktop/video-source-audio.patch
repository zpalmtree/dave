+    async def request_job_source_audio(self, job: dict[str, Any]) -> Path:
+        job_id = str(job["id"])
+        url = re.sub(r"^ws(s?)://", lambda match: "http" + match[1] + "://", self.broker_url)
+        url = re.sub(r"/v1/worker$", f"/v1/worker/jobs/{job_id}/source-audio", url)
+        destination = SCRIPT_DIR / "worker_audio" / f"{job_id}.wav"
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        temporary = destination.with_suffix(".part")
+        try:
+            async with self.http_session.post(url, json={}, headers=self.worker_headers(),
+                    timeout=aiohttp.ClientTimeout(total=120, connect=20)) as response:
+                if response.status != 200:
+                    raise RuntimeError(f"Song service returned HTTP {response.status}")
+                if response.headers.get("content-type", "").split(";", 1)[0] != "audio/wav":
+                    raise RuntimeError("Song service returned an invalid audio type")
+                size = 0
+                with temporary.open("wb") as handle:
+                    async for chunk in response.content.iter_chunked(65536):
+                        size += len(chunk)
+                        if size > 25 * 1024 * 1024:
+                            raise RuntimeError("Song exceeds 25 MiB")
+                        handle.write(chunk)
+            import wave
+            with wave.open(str(temporary), "rb") as audio:
+                duration = audio.getnframes() / audio.getframerate()
+                if not 1 <= duration <= 120 or abs(duration - float(job["source_audio_seconds"])) > .05:
+                    raise RuntimeError("Song duration does not match the job")
+            temporary.replace(destination)
+            return destination
+        finally:
+            temporary.unlink(missing_ok=True)
