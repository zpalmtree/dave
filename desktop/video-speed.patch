+class OpeningPrefetch:
+    """One cloud opening ahead. GPU fallback and continuity stay on the main scene path."""
+    def __init__(self, root, contract_hash, revision, request):
+        self.root, self.contract_hash, self.revision, self.request = root, contract_hash, revision, request
+        self.pending = None
+        self.pending_index = None
+
+    def cache_key(self, index, identity):
+        return {'contract_hash': self.contract_hash, 'revision': self.revision,
+                'segment_index': index, 'identity_anchor': identity.get('identity_anchor')}
+
+    def cached(self, index, identity):
+        path = self.root / f'scene-{index}' / 'prefetched-opening.json'
+        try:
+            value = json.loads(path.read_text(encoding='utf-8'))
+            if (value.get('key') == self.cache_key(index, identity)
+                    and isinstance(value.get('response'), dict)):
+                return value['response']
+        except (OSError, ValueError, KeyError, AttributeError):
+            pass
+        return None
+
+    async def fetch(self, index, identity):
+        value = self.cached(index, identity)
+        if value is not None:
+            return value
+        value = await self.request('image', {'segment_index': index, 'correction': [], **identity})
+        from video_worker import atomic_json
+        path = self.root / f'scene-{index}' / 'prefetched-opening.json'
+        path.parent.mkdir(exist_ok=True)
+        atomic_json(path, {'key': self.cache_key(index, identity), 'response': value})
+        return value
+
+    def start(self, index, segments, scenes, identity):
+        if (self.pending is not None or index >= len(segments)
+                or segments[index].get('transition') not in {'cut', 'dissolve'}):
+            return
+        scene = scenes.get(str(index), {})
+        if scene.get('image_accepted') or scene.get('pending_image') or scene.get('image_attempts'):
+            return
+        self.pending_index = index
+        self.pending = asyncio.create_task(self.fetch(index, identity))
+
+    async def take(self, index, identity):
+        if self.pending_index == index and self.pending is not None:
+            task, self.pending = self.pending, None
+            self.pending_index = None
+            return await task
+        return await self.fetch(index, identity)
+
+    async def close(self):
+        if self.pending is not None:
+            self.pending.cancel()
+            await asyncio.gather(self.pending, return_exceptions=True)
+            self.pending = None
+
