+    async def request_video_edit_reference(self, job: dict[str, Any], reference: Path) -> str:
+        if not self.http_session:
+            raise RuntimeError("Broker HTTP session is unavailable.")
+        payload = reference.read_bytes()
+        if not payload or len(payload) > KEYFRAME_LIMIT:
+            raise RuntimeError("The replacement image is empty or too large.")
+        # Downloaded references may not retain a meaningful extension.
+        mime = "image/jpeg" if payload.startswith(b"\xff\xd8") else \
+            "image/webp" if payload[:4] == b"RIFF" and payload[8:12] == b"WEBP" else "image/png"
+        url = re.sub(r"^wss://", "https://", self.broker_url)
+        url = re.sub(r"/v1/worker$", f"/v1/worker/jobs/{job['id']}/video-edit-reference", url)
+        async with self.http_session.post(
+            url, data=payload, headers={**self.worker_headers(), "Content-Type": mime},
+            timeout=aiohttp.ClientTimeout(total=60, connect=20),
+        ) as response:
+            body = await response.json()
+            if response.status != 200:
+                raise RuntimeError(str(body.get("error") or "Replacement image description failed.")[:500])
+        description = body.get("description")
+        if not isinstance(description, str) or not 20 <= len(description.strip()) <= 1000:
+            raise RuntimeError("The broker returned no usable replacement image description.")
+        return description.strip()
 
