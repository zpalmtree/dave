+def read_speech_plan(path, duration):
+    """Only explicit, source-relative target intervals may drive mouth animation."""
+    if path is None:
+        return None
+    plan = json.loads(Path(path).read_text(encoding='utf-8'))
+    if not isinstance(plan, dict):
+        raise ValueError('Invalid target speech plan')
+    declared = plan.get('source_seconds')
+    if isinstance(declared, bool) or not isinstance(declared, (int, float)) or not math.isfinite(declared) or abs(declared - duration) > 0.05:
+        raise ValueError('Speech plan does not match the source duration')
+    spans = plan.get('target_speech')
+    if not isinstance(spans, list) or len(spans) > 1000:
+        raise ValueError('Invalid target speech intervals')
+    intervals, previous = [], 0.0
+    for span in spans:
+        if not isinstance(span, dict):
+            raise ValueError('Invalid target speech interval')
+        a, b = span.get('start'), span.get('end')
+        if any(isinstance(v, bool) or not isinstance(v, (int, float)) or not math.isfinite(v) for v in (a, b)) or not 0 <= previous <= a < b <= duration:
+            raise ValueError('Target speech intervals must be ordered, nonoverlapping and inside the source')
+        intervals.append((float(a), float(b)))
+        previous = b
+    return intervals
+
+
+def speech_window(source, destination, start, intervals):
+    local = [(max(0, a - start), min(MODEL_FRAMES / 24, b - start))
+             for a, b in intervals if b > start and a < start + MODEL_FRAMES / 24]
+    gate = '+'.join(f'between(t,{a:.6f},{b:.6f})' for a, b in local) or '0'
+    edit.command('ffmpeg', '-nostdin', '-v', 'error', '-y', '-ss', f'{start:.9f}', '-i', str(source),
+                 '-map', '0:a:0', '-af', f"volume='if(gt({gate},0),1,0)':eval=frame,apad",
+                 '-t', f'{MODEL_FRAMES / 24:.9f}', '-ac', '2', '-ar', '32000', '-c:a', 'pcm_s16le', str(destination))
+    spans = ', '.join(f'{a:.3f} to {b:.3f} seconds' for a, b in local)
+    return (' The audio conditioning contains only the selected subject\'s own speech. '
+            'Synchronize mouth shapes and syllables precisely to this recording. '
+            + (f'The subject speaks only at these times relative to this segment: {spans}. ' if local else
+               'The selected subject is silent throughout this segment. ')
+            + 'At all other times the subject listens with a relaxed, closed mouth while preserving '
+            'the guide head movement and gestures. Never mouth the other speaker\'s dialogue.')
+
