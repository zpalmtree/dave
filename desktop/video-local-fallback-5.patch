+    def image_url(self, job: dict[str, Any], operation: str) -> str:
+        url = re.sub(r"^wss://", "https://", self.broker_url)
+        return re.sub(r"/v1/worker$", f"/v1/worker/image-jobs/{job['id']}/{operation}", url)
+
+    def image_headers(self, job: dict[str, Any]) -> dict[str, str]:
+        return {"Authorization": f"Bearer {self.token}", "X-Video-Lease": str(job["lease_id"])}
+
+    async def send_image_event(self, job: dict[str, Any], event: str, **fields: Any) -> None:
+        value = {"type": "image_event", "event": event, "job_id": job["id"], "lease_id": job["lease_id"], **fields}
+        if event in {"complete", "failed"}:
+            await self.wait_and_send(value)
+        else:
+            await self.send(value)
+
+    async def request_image_reference(self, job: dict[str, Any], index: int, root: Path) -> Path:
+        if not self.http_session:
+            raise RuntimeError("Broker HTTP session is unavailable.")
+        async with self.http_session.post(
+            f"{self.image_url(job, 'reference')}?index={index}",
+            json={},
+            headers=self.image_headers(job),
+            timeout=aiohttp.ClientTimeout(total=2 * 60, connect=20),
+        ) as response:
+            if response.status != 200:
+                raise RuntimeError(f"Reference image {index + 1} is unavailable ({response.status}).")
+            extension = {"image/jpeg": ".jpg", "image/png": ".png", "image/webp": ".webp"}.get(
+                str(response.headers.get("content-type") or "").split(";", 1)[0].lower()
+            )
+            payload = await response.read()
+        if not extension or not payload or len(payload) > KEYFRAME_LIMIT:
+            raise RuntimeError(f"Reference image {index + 1} is not a usable PNG, JPEG, or WebP file.")
+        destination = root / f"reference-{index}{extension}"
+        destination.write_bytes(payload)
+        return destination
+
+    async def upload_image_result(self, job: dict[str, Any], path: Path) -> None:
+        payload = path.read_bytes()
+        if not payload or len(payload) > IMAGE_RESULT_LIMIT:
+            raise RuntimeError("The generated image is empty or exceeds 25 MiB.")
+        headers = {
+            **self.image_headers(job),
+            "Content-Type": "image/png",
+            "X-Content-SHA256": hashlib.sha256(payload).hexdigest(),
+        }
+        for attempt in range(3):
+            await self.connected.wait()
+            if not self.http_session:
+                raise RuntimeError("Broker HTTP session is unavailable.")
+            try:
+                async with self.http_session.put(
+                    self.image_url(job, "result"),
+                    data=payload,
+                    headers=headers,
+                    timeout=aiohttp.ClientTimeout(total=5 * 60, connect=20),
+                ) as response:
+                    if response.status == 200:
+                        return
+                    detail = await response.text()
+                    if 400 <= response.status < 500:
+                        raise RuntimeError(f"Broker rejected the image ({response.status}): {detail}")
+            except (aiohttp.ClientError, asyncio.TimeoutError):
+                pass
+            await asyncio.sleep(2 * (attempt + 1))
+        raise RuntimeError("Could not upload the generated image.")
+
+    async def run_image_job(self, job: dict[str, Any]) -> None:
+        """Generate one standalone Qwen image under its own gpuq admission."""
+        job_id = str(job["id"])
+        root = IMAGE_JOB_DIR / job_id
+        shutil.rmtree(root, ignore_errors=True)
+        root.mkdir(parents=True, exist_ok=True)
+        log_path = LOG_DIR / f"image-{job_id}.log"
+        started = time.time()
+        stage_failed = "preparing the references"
+        try:
+            references = [
+                await self.request_image_reference(job, index, root)
+                for index in range(max(0, int(job.get("reference_count") or 0)))
+            ]
+            stage_failed = "generating the image"
+            spec = root / "spec.json"
+            output = root / "result.png"
+            atomic_json(spec, {
+                "model": job["model"],
+                "prompt": str(job.get("prompt") or ""),
+                "aspect": job.get("aspect"),
+                "references": [str(path) for path in references],
+            })
+            await self.send_image_event(job, "progress", stage="Generating")
+            command = self.gpuq_command([
+                console_python_executable(), "-s", str(GENERATOR),
+                "--image-job-input", str(spec), "--image-job-output", str(output),
+                "--seed", str(stable_job_seed(job_id)),
+            ], "video-h3", "normal")
+            LOG_DIR.mkdir(parents=True, exist_ok=True)
+            with log_path.open("w", encoding="utf-8") as log:
+                self.image_process = await asyncio.create_subprocess_exec(
+                    *command,
+                    cwd=str(ROOT_DIR),
+                    stdout=log,
+                    stderr=asyncio.subprocess.STDOUT,
+                    env={**os.environ, "PYTHONUTF8": "1", "PYTHONIOENCODING": "utf-8"},
+                    creationflags=CREATE_NO_WINDOW,
+                )
+                code = await self.image_process.wait()
+            self.image_process = None
+            if code != 0 or not output.is_file():
+                raise RuntimeError(self.last_log_error(log_path) or f"The image generator exited with code {code}.")
+            stage_failed = "uploading the image"
+            await self.send_image_event(job, "progress", stage="Uploading")
+            await self.upload_image_result(job, output)
+            await self.send_image_event(job, "complete", runtime_seconds=round(time.time() - started, 3))
+        except asyncio.CancelledError:
+            pass
+        except Exception as exc:
+            print(f"Image job {job_id} failed while {stage_failed}: {exc}", flush=True)
+            await self.send_image_event(
+                job,
+                "failed",
+                error=f"Failed while {stage_failed}: {exc}"[:1000],
+                retryable=stage_failed != "preparing the references",
+            )
+        finally:
+            self.image_process = None
+            self.image_job = None
+            self.image_task = None
+            shutil.rmtree(root, ignore_errors=True)
+            await self.send_ready()
+
+    async def cancel_image_job(self) -> None:
+        process = self.image_process
+        if process and process.returncode is None:
+            subprocess.run(
+                ["taskkill.exe", "/PID", str(process.pid), "/T", "/F"],
+                stdout=subprocess.DEVNULL,
+                stderr=subprocess.DEVNULL,
+                check=False,
+                creationflags=CREATE_NO_WINDOW,
+            )
+            await self.interrupt_comfy()
+        task = self.image_task
+        if task and task is not asyncio.current_task() and not task.done():
+            task.cancel()
+            await asyncio.gather(task, return_exceptions=True)
+
