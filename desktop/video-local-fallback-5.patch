+def generate_image_job(server: str, spec: dict[str, Any], seed: int, timeout_seconds: float) -> Path:
+    """A standalone $qwenimage or $qwenedit request: the user's prompt, unmodified, on the chosen model."""
+    prompt = str(spec.get("prompt") or "").strip()
+    if not prompt:
+        raise VideoGenError("an image job needs a prompt")
