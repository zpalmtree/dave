+def shot_blend_seconds(transition: str, previous: float, following: float) -> float:
+    """Default to a six-frame blend at independent shot boundaries (24 fps)."""
+    if transition == "dissolve":
+        requested = 0.5
+    elif transition == "cut":
+        try:
+            requested = float(os.environ.get("VIDEO_SHOT_BLEND_SECONDS", "0.25"))
+        except ValueError:
+            requested = 0.25
+        if not math.isfinite(requested):
+            requested = 0.25
+        requested = min(0.5, max(0.0, requested))
+    else:
+        return 0.0
+    # Bound against both adjacent clips, not the whole assembled timeline.
+    # Whole frames keep successive picture/audio overlaps on the same clock.
+    return math.floor(min(requested, previous / 4, following / 4) * FPS) / FPS
+
