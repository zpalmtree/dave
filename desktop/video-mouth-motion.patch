+def refine_mouth_motion(edited: Path, source: Path, mask: Path, work: Path) -> None:
+    """Refine silent speech openings while preserving the source frame timeline."""
+    if os.environ.get("VIDEO_EDIT_MOUTH_MOTION", "1") == "0":
+        return
+    output = work / "mouth-motion.mp4"
+    output.unlink(missing_ok=True)
+    try:
+        print("Matching the replacement's mouth openings to the silent source", flush=True)
+        outcome = run_wsl_pass("video_mouth_motion.py", [
+            "--source", wsl_path(source), "--video", wsl_path(edited), "--mask", wsl_path(mask),
+            "--state", wsl_path(work / "viggle.json"), "--output", wsl_path(output),
+        ], work / "mouth-motion.json", 90)
+        if outcome.get("action") == "mouth_motion" and output.is_file() and output.stat().st_size:
+            output.replace(edited)
+    except Exception as error:
+        print(f"Mouth motion refinement skipped: {error}"[:500], flush=True)
 
 
