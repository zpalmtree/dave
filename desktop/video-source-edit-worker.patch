+    async def request_job_source_video(self, job: dict[str, Any], destination: Path) -> Path:
+        job_id = str(job["id"])
+        url = re.sub(r"^wss://", "https://", self.broker_url)
+        url = re.sub(r"/v1/worker$", f"/v1/worker/jobs/{job_id}/source-video", url)
+        if not self.http_session:
+            raise RuntimeError("Broker HTTP session is unavailable.")
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        temporary = destination.with_suffix(".part")
+        try:
+            async with self.http_session.post(url, json={}, headers=self.worker_headers(),
+                    timeout=aiohttp.ClientTimeout(total=180, connect=20)) as response:
+                if response.status != 200:
+                    raise RuntimeError(f"Source video service returned HTTP {response.status}")
+                if int(response.headers.get("content-length") or 0) > 100 * 1024 * 1024:
+                    raise RuntimeError("Source video exceeds 100 MiB")
+                size = 0
+                with temporary.open("wb") as handle:
+                    async for chunk in response.content.iter_chunked(65536):
+                        size += len(chunk)
+                        if size > 100 * 1024 * 1024:
+                            raise RuntimeError("Source video exceeds 100 MiB")
+                        handle.write(chunk)
+            if size == 0:
+                raise RuntimeError("Source video is empty")
+            temporary.replace(destination)
+            return destination
+        finally:
+            temporary.unlink(missing_ok=True)
