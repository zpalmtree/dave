+import argparse
+from contextlib import ExitStack
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+import numpy as np
+from PIL import Image
+import video_edit as edit
+import video_edit_composite as composite
+import video_edit_recovery as recovery
+import video_edit_wan as wan
+
+
+class RecoveryTests(unittest.TestCase):
+    def test_review_reads_the_actual_final_frame_without_rounding_past_eof(self):
+        with tempfile.TemporaryDirectory() as directory:
+            clip = Path(directory) / 'last.mp4'
+            edit.command('ffmpeg', '-v', 'error', '-y', '-f', 'lavfi', '-i', 'color=black:s=64x64:r=24:d=3',
+                '-vf', "drawbox=x=0:y=0:w=64:h=64:color=red:t=fill:enable='eq(n,70)'",
+                '-frames:v', '71', '-c:v', 'libx264', '-pix_fmt', 'yuv420p', str(clip))
+            self.assertGreater(edit.rgb_frame(clip, 70 / 24, 64, 64)[:, :, 0].mean(), 230)
+            self.assertLess(edit.rgb_frame(clip, 69 / 24, 64, 64).mean(), 5)
+
+    def test_generated_tracking_error_does_not_blame_the_user_source_description(self):
+        with patch.object(edit, 'mask_frame_coverages', return_value=[0.1] * 3 + [0] * 17):
+            with self.assertRaisesRegex(RuntimeError, 'Animation was generated') as caught:
+                edit.validate_tracking_mask(Path('mask'), 'replacement', 20, generated=True)
+            self.assertNotIn('Describe', str(caught.exception))
+            self.assertIn('15%', str(caught.exception))
+            with self.assertRaisesRegex(RuntimeError, 'visible appearance and position'):
+                edit.validate_tracking_mask(Path('mask'), 'source subject', 20)
+
+    def test_redetection_is_bounded_and_does_not_override_a_second_failed_mask(self):
+        for retry, final_error, expected_calls in [(False, False, 1), (True, False, 2), (True, True, 2)]:
+            with self.subTest(retry=retry, final_error=final_error), tempfile.TemporaryDirectory() as directory:
+                root = Path(directory)
+                rendered = root / 'render.mp4'; rendered.write_bytes(b'video')
+                mask = root / 'mask.mp4'; mask.write_bytes(b'mask')
+                source = np.zeros((64, 96), np.uint8); source[10:60, 5:70] = 255
+                decisions = [RuntimeError('lost'), RuntimeError('still lost') if final_error else .2]
+                with patch.object(edit, 'INPUT', root), \
+                     patch.object(edit, 'decoded_frames', return_value=iter([source.tobytes()])), \
+                     patch.object(edit, 'run_graph', return_value=mask) as run, \
+                     patch.object(edit, 'validate_tracking_mask', side_effect=decisions):
+                    call = lambda: composite.track_replacement('server', rendered, mask, [0, 0, 80, 64],
+                        96, 64, 24, root / 'replacement.mp4', redetect=retry)
+                    if not retry or final_error:
+                        with self.assertRaises(composite.ReplacementTrackingError): call()
+                    else: call()
+                self.assertEqual(run.call_count, expected_calls)
+                if retry:
+                    graph = run.call_args.args[1]
+                    self.assertNotIn('track', graph)
+                    self.assertEqual(graph['frames']['inputs']['length'], 24)
+                    self.assertEqual(graph['detect']['inputs']['image'], ['frames', 0])
+                    self.assertEqual(graph['box']['inputs'], run.call_args_list[0].args[1]['box']['inputs'])
+                self.assertFalse(list(root.glob('edit-matte-*.mp4')))
+
+    def test_recovery_preserves_the_original_still_crop_timing_and_checks_the_new_track(self):
+        for fail in (False, True):
+            with self.subTest(fail=fail), tempfile.TemporaryDirectory() as directory:
+                root = Path(directory)
+                for category, name in [('diffusion_models', wan.MODEL), ('text_encoders', wan.TEXT),
+                                       ('clip_vision', wan.VISION), ('vae', wan.VAE)]:
+                    path = root / 'models' / category / name
+                    path.parent.mkdir(parents=True, exist_ok=True); path.write_bytes(b'fixture')
+                still = root / 'still.png'; still.write_bytes(b'accepted-original')
+                seen = []
+                def render(*args):
+                    seen.append(args)
+                    self.assertEqual(args[2].read_bytes(), still.read_bytes())
+                    return root / 'wan.mp4'
+                with patch.object(edit, 'COMFY', root), patch.object(edit, 'FAST_MODELS', root / 'none'), \
+                     patch.object(edit, 'INPUT', root), patch.object(edit, 'clip_details', return_value=(3, 512, 704)), \
+                     patch.object(wan, 'render', side_effect=render), patch('video_edit_isolated.place_video') as place, \
+                     patch.object(edit, 'reject_blank_edit') as blank, \
+                     patch.object(composite, 'track_replacement', side_effect=composite.ReplacementTrackingError('lost') if fail else None) as track:
+                    call = lambda: recovery.recover_animation('server', root / 'motion.mp4', still, root / 'source.mp4',
+                        root / 'mask.mp4', [0, 68, 440, 672], 448, 672, 71, root, root / 'new-mask.mp4', 1)
+                    if fail:
+                        with self.assertRaises(composite.ReplacementTrackingError): call()
+                    else:
+                        self.assertEqual(call(), root / 'recovered-render-01.mp4')
+                    self.assertEqual(len(seen), 1)
+                    self.assertEqual(seen[0][1], root / 'motion.mp4')
+                    self.assertEqual(seen[0][4:7], (304, 416, 71))
+                    self.assertEqual(place.call_args.args[2:], ([0, 68, 440, 672], 448, 672))
+                    blank.assert_called_once()
+                    self.assertTrue(track.call_args.kwargs['redetect'])
+                self.assertEqual(json.loads((root / 'animation-recovery-01.json').read_text())['status'], 'failed' if fail else 'tracked')
+                self.assertFalse(list(root.glob('edit-recovery-*')))
+
+    def test_missing_alternate_models_do_not_start_another_render(self):
+        with tempfile.TemporaryDirectory() as directory, patch.object(wan, 'render') as render, \
+             patch.object(edit, 'COMFY', Path(directory)), patch.object(edit, 'FAST_MODELS', Path(directory)):
+            with self.assertRaisesRegex(RuntimeError, 'alternate renderer is unavailable'):
+                recovery.recover_animation(None, None, None, None, None, None, 0, 0, 0, None, None, 1)
+            render.assert_not_called()
+
+    def test_only_failed_generated_tracking_retries_and_composites_recovered_pixels(self):
+        for renderer, error in [('viggle', None), ('viggle', composite.ReplacementTrackingError('lost')),
+                                ('viggle', RuntimeError('service down')), ('wan', composite.ReplacementTrackingError('lost'))]:
+            with self.subTest(renderer=renderer, error=error), tempfile.TemporaryDirectory() as directory, ExitStack() as stack:
+                root = Path(directory); work = root / 'work'; work.mkdir()
