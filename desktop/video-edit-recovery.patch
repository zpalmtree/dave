+"""One local motion-model retry after generated-subject tracking fails.
+
+Source selection, the accepted still and timing are retained. The normal compositor
+and broker motion review still decide whether the resulting video can be delivered.
+"""
+import json
+import uuid
+
+
+def recover_animation(server, motion_clip, still, source_clip, source_mask, box,
+                      width, height, frames, work, replacement_mask, index, description=None):
+    import video_edit as edit
+    import video_edit_wan as wan
+    from video_edit_isolated import place_video
+    from video_edit_composite import track_replacement
+
+    required = [('diffusion_models', wan.MODEL), ('text_encoders', wan.TEXT),
+                ('clip_vision', wan.VISION), ('vae', wan.VAE)]
+    if any(not any((root / category / name).is_file() for root in (edit.COMFY / 'models', edit.FAST_MODELS))
+           for category, name in required):
+        raise RuntimeError('Animation tracking failed and the local alternate renderer is unavailable. No finished video was produced.')
+    audit = work / f'animation-recovery-{index:02d}.json'
+    record = {'primary': 'viggle', 'fallback': 'wan', 'reason': 'replacement_tracking_failed', 'status': 'running'}
+    audit.write_text(json.dumps(record, indent=2), encoding='utf-8')
+    reference = edit.INPUT / ('edit-recovery-' + uuid.uuid4().hex + still.suffix.lower())
+    try:
+        # Use the accepted original still, not an independently generated image.
+        reference.write_bytes(still.read_bytes())
+        _, crop_width, crop_height = edit.clip_details(motion_clip)
+        scale = min(1.0, 416 / max(crop_width, crop_height))
+        wan_width = max(128, round(crop_width * scale / 16) * 16)
+        wan_height = max(128, round(crop_height * scale / 16) * 16)
+        print('Generated replacement tracking failed; retrying this segment once with Wan-Animate-2', flush=True)
+        raw = wan.render(server, motion_clip, reference,
+            description or "The character in the reference image, with the source scene's background.",
+            wan_width, wan_height, frames, work / f'wan-recovery-{index:02d}.mp4', 833969396 + index)
+        placed = work / f'recovered-render-{index:02d}.mp4'
+        place_video(raw, placed, box, width, height)
+        edit.reject_blank_edit(placed, source_mask, source_clip, still, frames / 24, width, height)
+        track_replacement(server, placed, source_mask, box, width, height, frames, replacement_mask, redetect=True)
+        record['status'] = 'tracked'
+        return placed
+    except Exception as error:
+        record.update(status='failed', error=str(error)[:1000])
+        raise
+    finally:
+        reference.unlink(missing_ok=True)
+        audit.write_text(json.dumps(record, indent=2), encoding='utf-8')
