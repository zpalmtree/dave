+                (work / 'viggle.json').write_text(json.dumps({'duration':1,'width':160,'height':96,
+                    'segments':[[0,24,124]],'isolated':True,'stills':[{'shot':0,'box':[0,0,160,96]}]}))
+                args = argparse.Namespace(viggle_render=work, still=[root/'still.png'], clip=root/'source.mp4',
+                    output=root/'result.mp4', server='server', isolated_renderer=renderer)
+                stack.enter_context(patch.object(edit, 'INPUT', root / 'input'))
+                for name in ('required_viggle_models', 'segment_clip', 'reject_blank_edit', 'match_render_levels'):
+                    stack.enter_context(patch.object(edit, name))
+                stack.enter_context(patch.object(edit, 'audio_codec', return_value=None))
+                stack.enter_context(patch.object(edit, 'still_effects', return_value=''))
+                stack.enter_context(patch.object(edit, 'run_graph', return_value=root/'primary.mp4'))
+                stack.enter_context(patch.object(edit, 'clip_details', return_value=(1, 160, 96)))
+                stack.enter_context(patch.object(wan, 'render', return_value=root/'wan.mp4'))
+                stack.enter_context(patch('video_edit_isolated.crop_video'))
+                stack.enter_context(patch('video_edit_isolated.place_video'))
+                review = stack.enter_context(patch('video_edit_isolated.review_samples'))
+                stack.enter_context(patch.object(composite, 'track_replacement', side_effect=error))
+                stack.enter_context(patch.object(composite, 'build_matte'))
+                recovered = stack.enter_context(patch.object(recovery, 'recover_animation', return_value=root/'recovered.mp4'))
+                levels = stack.enter_context(patch.object(edit, 'match_render_levels'))
+                stack.enter_context(patch.object(edit, 'composite_segment'))
+                stack.enter_context(patch.object(edit, 'join_segments', side_effect=lambda *a: args.output.write_bytes(b'output')))
+                if type(error) is RuntimeError or (renderer == 'wan' and error):
+                    with self.assertRaises(RuntimeError): edit.viggle_render(args)
+                    review.assert_not_called()
+                else:
+                    edit.viggle_render(args)
+                    review.assert_called_once_with(work, args.output)
+                self.assertEqual(recovered.call_count, int(renderer == 'viggle' and isinstance(error, composite.ReplacementTrackingError)))
+                if recovered.called:
+                    self.assertEqual(recovered.call_args.args[2], root/'still.png')
+                    self.assertEqual(levels.call_args.args[1], root/'recovered.mp4')
+
+
+if __name__ == '__main__': unittest.main()
