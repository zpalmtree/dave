+"""Local Wan-Animate-2 renderer for isolated, source-driven character motion.
+
+The original source crop is the motion input. The replacement reference supplies appearance; source framing must be
+checked in the composited output. Its expression is not a text instruction. No audio drives the face.
+"""
+MODEL = 'wan_animate_2_distill_int8_convrot.safetensors'
+TEXT = 'umt5_xxl_fp8_e4m3fn_scaled.safetensors'
+VISION = 'clip_vision_h.safetensors'
+VAE = 'wan_2.1_vae.safetensors'
+
+
+def graph(clip, reference, description, width, height, frames, prefix, seed=46):
+    from video_edit import node
+    if frames < 1 or (frames - 1) % 4:
+        raise ValueError('Wan windows must contain 4n+1 frames.')
+    return {
+        'model': node('UNETLoader', unet_name=MODEL, weight_dtype='default'),
+        'shift': node('ModelSamplingSD3', model=['model',0], shift=5.0),
+        'clip': node('CLIPLoader', clip_name=TEXT, type='wan', device='default'),
+        'positive': node('CLIPTextEncode', clip=['clip',0], text=description),
+        'negative': node('CLIPTextEncode', clip=['clip',0], text=''),
+        'motion_text': node('CLIPTextEncode', clip=['clip',0], text='The subject follows the source head movement, gaze, mouth movement and body motion. Fixed camera.'),
+        'vae': node('VAELoader', vae_name=VAE),
+        'source': node('LoadVideo', file=clip),
+        'frames': node('GetVideoComponents', video=['source',0]),
+        'first': node('ImageFromBatch', image=['frames',0], batch_index=0, length=1),
+        'reference': node('LoadImage', image=reference),
+        'vision': node('CLIPVisionLoader', clip_name=VISION),
+        'ref_vision': node('CLIPVisionEncode', clip_vision=['vision',0], image=['reference',0], crop='center'),
+        'pose_vision': node('CLIPVisionEncode', clip_vision=['vision',0], image=['first',0], crop='center'),
+        'condition': node('WanAnimate2ToVideo', positive=['positive',0], negative=['negative',0], vae=['vae',0],
+            width=width, height=height, length=frames, batch_size=1, video_frame_offset=0,
+            pose_strength=1.0, pose_start_percent=0.0, pose_end_percent=1.0, reference_image_strength=1.0,
+            reference_image=['reference',0], pose_video=['frames',0], clip_vision_output=['ref_vision',0],
+            positive_pose=['motion_text',0], clip_vision_output_pose=['pose_vision',0]),
+        'sample': node('KSampler', model=['shift',0], positive=['condition',0], negative=['condition',1],
+            latent_image=['condition',2], seed=seed, steps=10, cfg=1.0, sampler_name='euler', scheduler='simple', denoise=1.0),
+        'trim': node('TrimVideoLatent', samples=['sample',0], trim_amount=['condition',3]),
+        'decode': node('VAEDecode', samples=['trim',0], vae=['vae',0]),
+        'video': node('CreateVideo', images=['decode',0], fps=24.0),
+        'save': node('SaveVideo', video=['video',0], filename_prefix=prefix, format='mp4', codec='h264'),
+    }
+
+
+def windows(total, maximum=49):
+    """One-frame overlap carries motion inside a shot, never across a cut."""
+    if total < 1 or maximum < 5 or (maximum - 1) % 4:
+        raise ValueError('Invalid Wan window plan.')
+    start = 0
+    while start < total:
+        count = min(maximum, total - start)
+        overlap = int(start > 0)
+        yield start, count, 1 + ((count - 1 + 3) // 4) * 4, overlap
+        if start + count >= total:
+            break
+        start += count - 1
+
+
+def render(server, clip, reference, description, width, height, total_frames, destination, seed=46):
+    import json
+    import tempfile
+    import uuid
+    from pathlib import Path
+    import video_edit as edit
+    prefix = 'isolated-wan-' + uuid.uuid4().hex
+    previous = None
+    records = []
+    with tempfile.TemporaryDirectory(prefix=prefix) as temporary:
+        directory = Path(temporary)
+        segments = []
+        for index, (start, count, length, overlap) in enumerate(windows(total_frames)):
+            video = edit.INPUT / f'{prefix}-{index}.mp4'
+            continuation = edit.INPUT / f'{prefix}-{index}.png'
+            try:
+                edit.segment_clip(clip, video, start, count, length)
+                workflow = graph(video.name, reference.name, description, width, height, length,
+                                 f'video/edits/{prefix}-{index}', seed + index)
+                if previous:
+                    edit.extract_frame(previous, previous_length - 1, continuation)
+                    workflow['continuation'] = edit.node('LoadImage', image=continuation.name)
+                    workflow['condition']['inputs']['continue_motion'] = ['continuation', 0]
+                records.append({'start': start, 'count': count, 'overlap': overlap, 'workflow': workflow})
+                destination.with_suffix('.wan.json').write_text(json.dumps(records, indent=2), encoding='utf-8')
+                print(f'Wan-Animate-2 window {index + 1}, source frames {start}..{start+count-1}', flush=True)
+                output = edit.run_graph(server, workflow, 'save', 3600)
+                _, output_width, output_height = edit.clip_details(output, validate_source=False)
+                if (output_width, output_height) != (width, height):
+                    raise RuntimeError('Wan-Animate-2 returned the wrong canvas.')
+                segment = directory / f'window-{index}.mp4'
+                edit.command('ffmpeg', '-nostdin', '-v', 'error', '-y', '-i', str(output), '-vf',
+                             f'trim=start_frame={overlap}:end_frame={count},setpts=PTS-STARTPTS',
+                             '-an', '-c:v', 'libx264', '-crf', '18', '-pix_fmt', 'yuv420p', str(segment))
+                segments.append(segment)
+                previous, previous_length = output, count
+            finally:
+                video.unlink(missing_ok=True)
+                continuation.unlink(missing_ok=True)
+        edit.join_segments(segments, clip, destination, total_frames / 24, directory)
+    return destination
