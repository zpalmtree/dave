+class IsolatedEditTests(unittest.TestCase):
+    def test_frame_selection_covers_short_shots_and_bounds_long_shot_work(self):
+        self.assertEqual(isolated.candidate_frames(1), {0})
+        self.assertEqual(isolated.candidate_frames(15), set(range(15)))
+        selected = isolated.candidate_frames(268)
+        self.assertEqual(len(selected), 25)
+        self.assertTrue({0, 267}.issubset(selected))
+
+    def test_small_subject_crop_is_upscaled_for_motion_model(self):
+        self.assertEqual(isolated.crop_canvas([0,318,176,512]),(512,576))
+        for box in [[0,0,50,50],[0,0,800,600],[0,0,100,400]]:
+            w,h=isolated.crop_canvas(box)
+            self.assertLessEqual(max(w,h),896)
+            self.assertEqual(w%32,0);self.assertEqual(h%32,0)
+        with self.assertRaises(ValueError):isolated.crop_canvas([0,0,0,12])
+
+    def test_short_return_shot_resets_rendering_instead_of_merging_into_previous_shot(self):
+        import video_edit
+        shots = video_edit.shot_ranges([1,122,253],268,min_frames=1)
+        self.assertEqual(shots,[(0,1),(1,122),(122,253),(253,268)])
+        segments = video_edit.segment_plan(268/24,[1,122,253],min_shot_frames=1)
+        self.assertEqual([(start,count) for start,count,_ in segments],[(0,1),(1,121),(122,131),(253,15)])
+        self.assertEqual(sum(count for _,count,_ in segments),268)
+
+    def test_track_union_preserves_position_clamps_frame_edges_and_chroma_alignment(self):
+        mask = np.zeros((96,160),dtype=np.uint8)
+        mask[43:93,1:41]=255
+        box = isolated.union_box([isolated.bounds(mask),[3,40,50,96]],160,96)
+        self.assertEqual(box,[0,28,62,96])
+        with self.assertRaisesRegex(RuntimeError,'empty track'):
+            isolated.union_box([],160,96)
+
+    def test_clear_target_wins_over_blur_and_sharp_background(self):
+        selected=np.zeros((96,160),dtype=bool); selected[40:90,:40]=True
+        blurry=np.zeros((96,160,3),dtype=np.uint8)
+        blurry[:,100::2]=255
+        clear=blurry.copy(); clear[40:90:3,:40]=180
+        self.assertGreater(isolated.detail_score(clear,selected),isolated.detail_score(blurry,selected))
+
+    def test_missing_shot_is_not_delivered_as_original_footage(self):
+        with tempfile.TemporaryDirectory() as directory:
+            work=Path(directory)
+            (work/'viggle.json').write_text(json.dumps({'edited':[True,False]}))
+            with self.assertRaisesRegex(RuntimeError,'partial edit'):
+                isolated.prepare(work)
+
+    def test_crop_is_source_derived_and_cannot_select_the_other_person(self):
+        with tempfile.TemporaryDirectory() as directory:
+            work=Path(directory)
+            frame=np.zeros((96,160,3),dtype=np.uint8)
+            frame[:,100:]=[255,0,0] # other person on the right
+            frame[40:90,:40]=[0,255,0] # intended subject lower left
+            Image.fromarray(frame).save(work/'frame-01.png')
+            state={'edited':[True], 'width':160,'height':96,'segments':[[0,24,124]],
+                   'segment_shots':[0],'stills':[{'shot':0,'frame':'frame-01.png'}]}
+            (work/'viggle.json').write_text(json.dumps(state))
+            mask=np.zeros((96,160),dtype=np.uint8); mask[40:90,:40]=255
+            with patch('video_edit.decoded_frames',side_effect=[iter([mask.tobytes()]*24),iter([frame.tobytes()]*24)]):
+                result=isolated.prepare(work)
+            with Image.open(work/result['stills'][0]['frame']) as crop:
+                self.assertEqual(np.asarray(crop)[:,:,0].max(),0)
+                self.assertEqual(np.asarray(crop)[:,:,1].max(),255)
+            self.assertEqual(result['stills'][0]['box'],[0,28,52,96])
+
+    def test_review_includes_both_sides_of_cut_and_late_segment(self):
+        with tempfile.TemporaryDirectory() as directory:
