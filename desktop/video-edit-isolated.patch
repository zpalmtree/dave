+import unittest
+from video_edit_wan import graph, windows
+
+class WanEditTests(unittest.TestCase):
+    def test_source_video_controls_pose_and_reference_controls_identity(self):
+        workflow=graph('crop.mp4','repaint.png','a replacement',384,416,49,'test')
+        self.assertEqual(workflow['condition']['inputs']['pose_video'],['frames',0])
+        self.assertEqual(workflow['condition']['inputs']['reference_image'],['reference',0])
+        self.assertEqual(workflow['pose_vision']['inputs']['image'],['first',0])
+        self.assertEqual(workflow['ref_vision']['inputs']['image'],['reference',0])
+        self.assertEqual(workflow['trim']['inputs']['trim_amount'],['condition',3])
+        self.assertEqual(workflow['video']['inputs']['fps'],24)
+        self.assertFalse(any('Audio' in item['class_type'] for item in workflow.values()))
+
+    def test_windows_preserve_exact_timeline_for_short_shots_and_continuations(self):
+        for count in [1,2,15,49,50,121,131,2880]:
+            plan=list(windows(count))
+            restored=[]
