+"""Spatially isolated source edits; no model is allowed to choose another performer.
+
+Crops and masks come from source tracking. Renderers receive only that crop; their
+output is mapped back into the source coordinates and composited through the track.
+"""
+import base64
+import io
+import json
+from pathlib import Path
+
+import numpy as np
+from PIL import Image
+
+
+def union_box(boxes, width, height, margin=12):
+    if not boxes:
+        raise RuntimeError('Could not reliably isolate the target: empty track.')
+    left = max(0, min(box[0] for box in boxes) - margin)
+    top = max(0, min(box[1] for box in boxes) - margin)
+    right = min(width, max(box[2] for box in boxes) + margin)
+    bottom = min(height, max(box[3] for box in boxes) + margin)
+    # Even coordinates retain chroma alignment for yuv420p crop and pad.
+    return [left // 2 * 2, top // 2 * 2, min(width, (right + 1) // 2 * 2), min(height, (bottom + 1) // 2 * 2)]
+
+
+def detail_score(pixels, selected):
+    gray = np.mean(pixels.astype(np.float32), axis=2)
+    # Interior mask avoids scoring high-contrast silhouettes/background boundaries.
+    interior = selected[1:-1, 1:-1] & selected[:-2, 1:-1] & selected[2:, 1:-1] \
+        & selected[1:-1, :-2] & selected[1:-1, 2:]
+    if not interior.any():
+        return 0.0
+    detail = np.abs(gray[1:-1, :-2] - gray[1:-1, 2:]) + np.abs(gray[:-2, 1:-1] - gray[2:, 1:-1])
+    return float(np.mean(detail[interior]) * (selected.mean() ** 0.25))
+
+
+def bounds(mask):
+    rows, cols = np.nonzero(mask > 127)
+    return [int(cols.min()), int(rows.min()), int(cols.max()) + 1, int(rows.max()) + 1] if len(rows) else None
+
+
+def candidate_frames(count):
+    """Inspect every frame of short shots, and at most 25 spread across long ones."""
+    return {round(index * (count - 1) / max(1, min(count, 25) - 1))
+            for index in range(min(count, 25))}
+
+
+def prepare(work):
+    from video_edit import decoded_frames
+    state_path = work / 'viggle.json'
+    state = json.loads(state_path.read_text(encoding='utf-8'))
+    if not all(state['edited']):
+        raise RuntimeError('Could not reliably isolate the target in every segment; refusing a partial edit.')
+    w, h = state['width'], state['height']
+    boxes = {}
+    candidates = {}
+    for index, (start, count, _) in enumerate(state['segments']):
+        shot = state['segment_shots'][index]
+        selected_frames = candidate_frames(count)
+        for local, data in enumerate(decoded_frames(work / f'mask-{index + 1:02d}.mp4', 'gray', w * h, count)):
+            mask = np.frombuffer(data, dtype=np.uint8).reshape(h, w)
+            box = bounds(mask)
+            if box:
+                boxes.setdefault(shot, []).append(box)
+                if local in selected_frames:
+                    candidates[start + local] = (shot, mask > 127)
+    # Area alone selected a blurred back of the head in 8a743884. Score visible detail
+    # only INSIDE the tracked subject, with a small preference for larger detections.
+    best = {}
+    total = max(start + count for start, count, _ in state['segments'])
+    for frame, data in enumerate(decoded_frames(work / 'normalized.mp4', 'rgb24', w * h * 3, total)):
+        if frame not in candidates:
+            continue
+        shot, selected = candidates[frame]
+        pixels = np.frombuffer(data, dtype=np.uint8).reshape(h, w, 3)
+        score = detail_score(pixels, selected)
+        if score > best.get(shot, (-1, 0, None))[0]:
+            best[shot] = (score, frame, pixels.copy())
+    for still in state['stills']:
+        box = union_box(boxes.get(still['shot'], []), w, h)
+        still['box'] = box
+        if still['shot'] in best:
+            _, still['frame_index'], pixels = best[still['shot']]
+            Image.fromarray(pixels).save(work / still['frame'])
+        still['full_frame'] = still['frame']
+        crop = f'crop-{still["shot"] + 1:02d}.png'
+        with Image.open(work / still['frame']) as frame:
+            frame.crop(box).save(work / crop)
+        still['frame'] = crop
+    state['isolated'] = True
+    state_path.write_text(json.dumps(state, indent=2), encoding='utf-8')
+    return state
+
+
+def crop_canvas(box):
+    # The full-frame helper only downsizes. Using it for a small target produced
+    # 160x176 motion inputs, far below the motion model's working resolution.
+    width, height = box[2] - box[0], box[3] - box[1]
+    if width <= 0 or height <= 0:
+        raise ValueError('Empty target crop.')
+    scale = min(512 / min(width, height), 896 / max(width, height))
+    return max(32, round(width * scale / 32) * 32), max(32, round(height * scale / 32) * 32)
+
+
+def crop_video(source, destination, box):
+    from video_edit import command
+    x, y, right, bottom = box
+    w, h = crop_canvas(box)
+    command('ffmpeg', '-nostdin', '-v', 'error', '-y', '-i', str(source), '-vf',
+            f'crop={right-x}:{bottom-y}:{x}:{y},scale={w}:{h}', '-an', '-c:v', 'libx264', '-crf', '18', str(destination))
+    return w, h
+
+
+def place_video(source, destination, box, width, height):
+    from video_edit import command
+    x, y, right, bottom = box
+    command('ffmpeg', '-nostdin', '-v', 'error', '-y', '-i', str(source), '-vf',
+            f'scale={right-x}:{bottom-y},pad={width}:{height}:{x}:{y}:black', '-an', '-c:v', 'libx264', '-crf', '18', str(destination))
+
+
+def fit_still(source, destination, box):
+    w, h = crop_canvas(box)
+    with Image.open(source) as image:
+        image.convert('RGB').resize((w, h), Image.Resampling.LANCZOS).save(destination)
+
+
+def jpeg(pixels):
+    buffer = io.BytesIO()
+    Image.fromarray(pixels).save(buffer, format='JPEG', quality=85)
+    return base64.b64encode(buffer.getvalue()).decode('ascii')
+
+
+def review_samples(work, output):
+    """Every segment, including the first and last frame on each side of each cut."""
+    from video_edit import clip_details, rgb_frame
+    state = json.loads((work / 'viggle.json').read_text(encoding='utf-8'))
+    duration, w, h = clip_details(output)
+    if abs(duration - state['duration']) > 2 / 24 or (w, h) != (state['width'], state['height']):
+        raise RuntimeError('The replacement changed the source duration or canvas.')
+    paths = []
+    for index, (start, count, _) in enumerate(state['segments']):
+        samples = []
+        for frame in sorted({0, (count - 1) // 3, 2 * (count - 1) // 3, count - 1}):
+            t = (start + frame) / 24
+            samples.append({'source': jpeg(rgb_frame(work / 'normalized.mp4', t, w, h)),
+                            'edited': jpeg(rgb_frame(output, t, w, h)),
+                            'mask': jpeg(rgb_frame(work / f'mask-{index+1:02d}.mp4', frame / 24, w, h))})
+        path = work / f'review-{index+1:02d}.json'
+        path.write_text(json.dumps({'segment': index+1, 'samples': samples}), encoding='utf-8')
+        paths.append(path.name)
+    (work / 'reviews.json').write_text(json.dumps(paths), encoding='utf-8')
