+class AudioContinuityTests(unittest.TestCase):
+    def test_profiles_survive_validation_and_anchor_both_compilers(self):
+        plan = sample_plan("Hello.")
+        plan["speaker_profiles"] = [
+            {"speaker_id": "woman", "voice_description": "bright alto"},
+            {"speaker_id": "man", "voice_description": "low chest resonance, Mexican Spanish accent"},
+        ]
+        second = video_gen.copy.deepcopy(plan["segments"][0])
+        second.update(transition="cut", audio_transition="fade")
+        second["shots"][0]["dialogue"][0]["delivery"] = "shouting"
+        plan["segments"].append(second)
+        normalized = video_gen.validate_plan_shape(plan, "", None, 15.0, 5.0)
+        self.assertEqual(normalized["speaker_profiles"], plan["speaker_profiles"])
+        prepared = video_gen.prepare_model_segments("", normalized, "h3", None, {}, False, 1.0)
+        self.assertEqual(prepared[1]["audio_transition"], "fade")
+        for segment in prepared:
+            self.assertIn("man (S2)", segment["prompt"])
+            self.assertIn("low chest resonance, Mexican Spanish accent", segment["prompt"])
+            self.assertIn("<d>[English] Hello.</d>", segment["prompt"])
+        self.assertIn("this turn's performance: shouting", prepared[1]["prompt"])
+        ltx = video_gen.compile_ltx_draft({"shots": prepared[1]["shots"], "music": "N/A"}, False)
+        self.assertIn("low chest resonance, Mexican Spanish accent", ltx)
+        self.assertIn('says exactly: "Hello."', ltx)
+
+    def test_legacy_profiles_and_invalid_contracts(self):
+        plan = sample_plan("Hello.")
+        second = video_gen.copy.deepcopy(plan["segments"][0])
+        second["shots"][0]["dialogue"] = [
+            {"speaker_id": "woman", "delivery": "bright alto", "text": "Hi."},
+            {"speaker_id": "MAN", "delivery": "angry", "text": "Wait."},
+        ]
+        plan["segments"].append(second)
+        profiles = video_gen.normalize_audio_continuity(plan)
+        self.assertEqual(profiles, [
+            {"speaker_id": "man", "voice_description": "calmly"},
+            {"speaker_id": "woman", "voice_description": "bright alto"},
+        ])
+        self.assertEqual(second["shots"][0]["dialogue"][1]["delivery"], "angry")
+        self.assertEqual(video_gen.normalize_audio_continuity(sample_plan()), [])
+        plan["speaker_profiles"] = profiles + [profiles[0]]
+        with self.assertRaisesRegex(video_gen.VideoGenError, "unique"):
+            video_gen.normalize_audio_continuity(plan)
+        plan.pop("speaker_profiles")
+        plan["segments"][0]["audio_transition"] = "invalid"
+        with self.assertRaisesRegex(video_gen.VideoGenError, "audio transition"):
+            video_gen.normalize_audio_continuity(plan)
+
