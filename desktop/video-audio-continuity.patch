+def normalize_audio_continuity(plan: dict[str, Any]) -> list[dict[str, str]]:
+    """Preserve explicit identities; migrate legacy plans from each speaker's first turn."""
+    profiles: dict[str, dict[str, str]] = {}
+    supplied = plan.get("speaker_profiles", [])
+    if not isinstance(supplied, list):
+        raise VideoGenError("speaker_profiles must be an array")
+    for profile in supplied:
+        if not isinstance(profile, dict):
+            raise VideoGenError("speaker profile must be an object")
+        speaker = str(profile.get("speaker_id") or "").strip()
+        voice = str(profile.get("voice_description") or "").strip()
+        if not speaker or not voice or speaker.casefold() in profiles:
+            raise VideoGenError("speaker profiles need unique IDs and nonempty voice descriptions")
+        profiles[speaker.casefold()] = {"speaker_id": speaker, "voice_description": voice}
+    for segment in plan.get("segments", []):
+        transition = segment.get("audio_transition", "auto")
+        if transition not in {"auto", "cut", "fade"}:
+            raise VideoGenError(f"invalid audio transition: {transition}")
+        segment["audio_transition"] = transition
+        for shot in segment.get("shots", []):
+            for line in shot.get("dialogue", []):
+                speaker = str(line.get("speaker_id") or "").strip()
+                if speaker and speaker.casefold() not in profiles:
+                    profiles[speaker.casefold()] = {
+                        "speaker_id": speaker,
+                        "voice_description": str(line.get("delivery") or "natural voice").strip() or "natural voice",
+                    }
+    return list(profiles.values())
+
+
+def bind_segment_voices(plan: dict[str, Any], segments: list[dict[str, Any]]) -> None:
+    profiles = normalize_audio_continuity(plan)
+    by_id = {profile["speaker_id"].casefold(): (index, profile)
+             for index, profile in enumerate(profiles, 1)}
+    for segment in segments:
+        for shot in segment.get("shots", []):
+            for line in shot.get("dialogue", []):
+                entry = by_id.get(str(line.get("speaker_id", "")).strip().casefold())
+                if entry:
+                    index, profile = entry
+                    line["voice_description"] = profile["voice_description"]
+                    line["speaker_tag"] = f"S{index}"
+
