+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+import numpy as np
+import video_edit
+from video_edit_composite import composite_alpha, build_matte, replacement_graph
+
+
+class CompositeTests(unittest.TestCase):
+    def test_covers_both_silhouettes_and_fills_interior_holes(self):
+        source = np.zeros((64, 96), np.uint8)
+        source[20:50, 10:35] = 255
+        source[28:32, 20:24] = 0
+        rendered = np.zeros_like(source)
+        rendered[15:48, 25:48] = 255
+        alpha = composite_alpha(source, rendered, [0, 0, 70, 64])
+        self.assertTrue(np.all(alpha[source > 0] == 255))
+        self.assertTrue(np.all(alpha[rendered > 0] == 255))
+        self.assertEqual(alpha[29, 21], 255)
+        self.assertTrue(np.any((alpha > 0) & (alpha < 255)))
+
+    def test_filters_never_reveal_black_padding_outside_rendered_crop(self):
+        source = np.zeros((64, 96), np.uint8)
+        source[20:50, 10:35] = 255
+        rendered = np.zeros_like(source)
+        rendered[10:50, 25:60] = 255
+        alpha = composite_alpha(source, rendered, [0, 10, 60, 64])
+        self.assertFalse(alpha[:10].any())
+        self.assertFalse(alpha[:, 60:].any())
+        self.assertEqual(alpha[20, 59], 255)
+
+    def test_empty_occluded_frame_has_no_spurious_alpha(self):
+        blank = np.zeros((64, 96), np.uint8)
+        self.assertFalse(composite_alpha(blank, blank, [0, 0, 96, 64]).any())
+
+    def test_uncovered_original_subject_stops_instead_of_leaving_it_in_video(self):
+        source = np.zeros((64, 96), np.uint8)
+        source[20:50, 10:50] = 255
+        with self.assertRaisesRegex(RuntimeError, 'outside the generated crop'):
+            composite_alpha(source, source, [0, 0, 40, 64])
+
+    def test_no_history_from_previous_shot_is_used(self):
+        left = np.zeros((64, 96), np.uint8); left[10:50, 5:30] = 255
+        right = np.zeros_like(left); right[10:50, 65:90] = 255
+        composite_alpha(left, left, [0, 0, 96, 64])
+        alpha = composite_alpha(right, right, [0, 0, 96, 64])
+        self.assertFalse(alpha[:, :40].any())
+
+    def test_spatial_tracking_does_not_choose_a_second_subject_by_text(self):
+        graph = replacement_graph('clip.mp4', [8, 12, 80, 100], 'test/matte')
+        self.assertNotIn('target', graph)
+        self.assertNotIn('conditioning', graph['track']['inputs'])
+        self.assertEqual(graph['track']['inputs']['initial_mask'], ['detect', 0])
+        self.assertEqual(graph['box']['inputs'], {'x': 8, 'y': 12, 'width': 72, 'height': 88})
+
+    def test_short_or_mismatched_tracks_fail_before_encoding(self):
+        frame = np.zeros((64, 96), np.uint8).tobytes()
+        with tempfile.TemporaryDirectory() as d:
+            for source, rendered in [([frame], [frame, frame]), ([frame], [frame])]:
+                with patch('video_edit.decoded_frames', side_effect=[iter(source), iter(rendered)]), \
+                     patch('video_edit.command') as encode:
+                    with self.assertRaisesRegex(RuntimeError, 'timeline|shorter'):
+                        build_matte(Path('source'), Path('render'), Path(d)/'alpha.mkv', [0, 0, 96, 64], 96, 64, 2)
+                    encode.assert_not_called()
+
+    def test_lossless_alpha_keeps_every_frame_and_exact_crop_boundary(self):
+        mask = np.zeros((64, 96), np.uint8); mask[16:48, 8:48] = 255
+        frame = mask.tobytes()
+        with tempfile.TemporaryDirectory() as d:
+            output = Path(d)/'alpha.mkv'
+            with patch('video_edit.decoded_frames', side_effect=[iter([frame]*3), iter([frame]*3)]):
+                build_matte(Path('source'), Path('render'), output, [0, 0, 48, 64], 96, 64, 3)
+            decoded = list(video_edit.decoded_frames(output, 'gray', 96*64, 4))
+            self.assertEqual(len(decoded), 3)
+            for data in decoded:
+                alpha = np.frombuffer(data, np.uint8).reshape(64, 96)
+                self.assertFalse(alpha[:, 48:].any())
+                self.assertTrue(np.all(alpha[mask > 0] == 255))
+
+    def test_brightness_fit_ignores_black_padding_and_untouched_people(self):
+        w, h = 96, 64
+        rendered = np.zeros((h, w, 3), np.uint8)
+        rendered[:, :48] = np.linspace(55, 145, 48, dtype=np.uint8)[None, :, None]
+        source = np.full_like(rendered, 255)  # unrelated bright scene outside crop
+        source[:, :48] = np.clip(rendered[:, :48] * 1.2 + 10, 0, 255)
+        mask = np.zeros((h, w), np.uint8)
+        def frames(path, pixel_format, frame_bytes, count, filters=None):
+            value = source if str(path) == 'source' else rendered if str(path) == 'rendered' else mask
+            return iter([value.tobytes()] * count)
+        fits = []
+        actual_fit = video_edit.fit_levels
+        def fit(a, b):
+            fits.append((a, b))
+            return actual_fit(a, b)
+        with tempfile.TemporaryDirectory() as d, patch('video_edit.decoded_frames', side_effect=frames), \
+             patch('video_edit.fit_levels', side_effect=fit):
+            video_edit.match_render_levels(Path('source'), Path('rendered'), Path('mask'), Path(d)/'out.mp4',
+                                           2, w, h, region=[0, 0, 48, 64])
+        self.assertEqual(len(fits), 2)
+        for source_samples, rendered_samples in fits:
+            self.assertLess(source_samples.max(), 0.8)
+            self.assertGreater(rendered_samples.min(), 0.15)
+
+    def test_prepared_alpha_is_not_blurred_or_grown_again(self):
+        with patch('video_edit.command') as command:
+            video_edit.composite_segment(Path('source'), Path('render'), Path('alpha'), Path('out'),
+                                         5, dilate=False, feather=False)
+        graph = command.call_args.args[command.call_args.args.index('-filter_complex') + 1]
+        self.assertNotIn('dilation', graph)
+        self.assertNotIn('gblur', graph)
+
+
+if __name__ == '__main__':
+    unittest.main()
