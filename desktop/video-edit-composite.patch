+"""Cover both subject silhouettes without blending the original performer back in."""
+import tempfile
+import uuid
+from pathlib import Path
+
+import numpy as np
+from scipy.ndimage import binary_closing, binary_dilation, binary_fill_holes, distance_transform_edt
+
+
+def replacement_graph(clip, box, prefix):
+    from video_edit import node, segmentation_graph
+    graph = segmentation_graph(clip, '', prefix)
+    del graph['target']
+    graph['track']['inputs'].pop('conditioning')
+    graph['first'] = node('ImageFromBatch', image=['frames', 0], batch_index=0, length=1)
+    x, y, right, bottom = box
+    graph['box'] = node('PrimitiveBoundingBox', x=x, y=y, width=right-x, height=bottom-y)
+    graph['detect'] = node('SAM3_Detect', model=['sam', 0], image=['first', 0], bboxes=['box', 0],
+                           threshold=0.5, refine_iterations=2, individual_masks=False)
+    graph['track']['inputs']['initial_mask'] = ['detect', 0]
+    return graph
+
+
+def track_replacement(server, rendered, source_mask, box, width, height, frames, destination):
+    import video_edit as edit
+    from video_edit_isolated import bounds, union_box
+    # A spatial prompt works for humans, animals and objects. Do not ask a second
+    # text detector to choose the most prominent performer in the original scene.
+    first = next(edit.decoded_frames(source_mask, 'gray', width * height, 1), None)
+    if first is None:
+        raise RuntimeError('Missing source mask for replacement compositing.')
+    source_box = bounds(np.frombuffer(first, np.uint8).reshape(height, width))
+    seed = union_box([source_box], width, height) if source_box else list(box)
+    seed = [max(seed[0], box[0]), max(seed[1], box[1]), min(seed[2], box[2]), min(seed[3], box[3])]
+    if seed[2] <= seed[0] or seed[3] <= seed[1]:
+        raise RuntimeError('Replacement track lies outside its source crop.')
+    name = 'edit-matte-' + uuid.uuid4().hex
+    clip = edit.INPUT / (name + '.mp4')
+    try:
+        clip.write_bytes(Path(rendered).read_bytes())
+        graph = replacement_graph(clip.name, seed, 'video/edits/' + name)
+        import json
+        destination.with_suffix('.json').write_text(json.dumps(graph, indent=2), encoding='utf-8')
+        result = edit.run_graph(server, graph, 'save_mask', 1800)
+        edit.validate_tracking_mask(result, 'the rendered replacement', frames)
+        destination.write_bytes(result.read_bytes())
+    finally:
+        clip.unlink(missing_ok=True)
+
+
+def composite_alpha(source, replacement, box, padding=3, feather=4):
+    """Opaque union with an outward feather, clipped AFTER filtering to render support."""
+    source = source > 127
+    replacement = replacement > 127
+    if source.shape != replacement.shape or source.ndim != 2:
+        raise ValueError('Source and replacement masks must have identical dimensions.')
+    height, width = source.shape
+    x, y, right, bottom = box
+    if not (0 <= x < right <= width and 0 <= y < bottom <= height):
+        raise ValueError('Invalid replacement crop.')
+    support = np.zeros((height, width), bool)
+    support[y:bottom, x:right] = True
+    if np.any(source & ~support):
+        raise RuntimeError('Source subject extends outside the generated crop.')
+    core = (source | replacement) & support
+    if not core.any():
+        return np.zeros((height, width), np.uint8)
+    # Closing removes little cracks without eroding subjects that reach a frame edge.
+    closed = binary_closing(np.pad(core, 2, mode='edge'), structure=np.ones((5, 5), bool))[2:-2, 2:-2]
+    core |= binary_fill_holes(closed)
+    hard = binary_dilation(core, iterations=padding) if padding else core
+    distance = distance_transform_edt(~hard)
+    alpha = np.clip(1 - distance / max(1, feather), 0, 1)
+    alpha = alpha * alpha * (3 - 2 * alpha)
+    # Black padding outside a placed render is not image content. Growing/blurring
+    # the alpha after this clamp would produce the visible black rectangle again.
+    alpha[~support] = 0
+    return np.round(alpha * 255).astype(np.uint8)
+
+
+def build_matte(source, replacement, destination, box, width, height, frames):
+    import video_edit as edit
+    from itertools import zip_longest
+    if frames < 1:
+        raise ValueError('A composite needs at least one frame.')
+    frame_bytes = width * height
+    with tempfile.TemporaryDirectory(prefix='edit-alpha-') as directory:
+        raw = Path(directory) / 'alpha.gray'
+        count = 0
+        with raw.open('wb') as stream:
+            for a, b in zip_longest(edit.decoded_frames(source, 'gray', frame_bytes, frames),
+                                   edit.decoded_frames(replacement, 'gray', frame_bytes, frames)):
+                if a is None or b is None:
+                    raise RuntimeError('Replacement masks do not cover the same timeline.')
+                alpha = composite_alpha(np.frombuffer(a, np.uint8).reshape(height, width),
+                                        np.frombuffer(b, np.uint8).reshape(height, width), box)
+                stream.write(alpha.tobytes())
+                count += 1
+        if count != frames:
+            raise RuntimeError('Replacement masks are shorter than the source segment.')
+        edit.command('ffmpeg', '-nostdin', '-v', 'error', '-y', '-f', 'rawvideo', '-pix_fmt', 'gray',
+                     '-video_size', f'{width}x{height}', '-framerate', '24', '-i', str(raw),
+                     '-an', '-c:v', 'ffv1', '-pix_fmt', 'gray', str(destination))
