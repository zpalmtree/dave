+def delivery_canvas(source: Path) -> tuple[int, int]:
+    """Keep native landscape renders; widen portrait/square delivery without cropping."""
+    width, height = video_canvas(source)
+    if width <= height:
+        # Retain every source pixel vertically instead of restoring the old
+        # 960x720 downscale. Normalization adds side padding, never stretches.
+        width = (height * 16 + 8) // 9
+        width += width % 2
+    return width, height
 
 
