+def edit_keyframe_graph(prompt: str, aspect: str, seed: int, prefix: str, reference_names: list[str]) -> dict[str, Any]:
+    """Qwen-Image-Edit-2511 with its Lightning LoRA, following the official ComfyUI template."""
+    width, height = KEYFRAME_DIMENSIONS[aspect]
+    graph: dict[str, Any] = {
+        "model": {"class_type": "UNETLoader",
+                  "inputs": {"unet_name": QWEN_EDIT_DIFFUSION_MODEL, "weight_dtype": "default"}},
+        "lora": {"class_type": "LoraLoaderModelOnly",
+                 "inputs": {"model": ["model", 0], "lora_name": QWEN_EDIT_LIGHTNING_LORA, "strength_model": 1.0}},
+        "shift": {"class_type": "ModelSamplingAuraFlow", "inputs": {"model": ["lora", 0], "shift": 3.1}},
+        "norm": {"class_type": "CFGNorm", "inputs": {"model": ["shift", 0], "strength": 1.0}},
+        "clip": {"class_type": "CLIPLoader",
+                 "inputs": {"clip_name": QWEN_EDIT_TEXT_ENCODER, "type": "qwen_image", "device": "default"}},
+        "vae": {"class_type": "VAELoader", "inputs": {"vae_name": QWEN_EDIT_VAE}},
+        "positive_text": {"class_type": "TextEncodeQwenImageEditPlus",
+                          "inputs": {"clip": ["clip", 0], "prompt": prompt, "vae": ["vae", 0]}},
+        "negative_text": {"class_type": "TextEncodeQwenImageEditPlus",
+                          "inputs": {"clip": ["clip", 0], "prompt": "", "vae": ["vae", 0]}},
+        "positive": {"class_type": "FluxKontextMultiReferenceLatentMethod",
+                     "inputs": {"conditioning": ["positive_text", 0], "reference_latents_method": "index_timestep_zero"}},
+        "negative": {"class_type": "FluxKontextMultiReferenceLatentMethod",
+                     "inputs": {"conditioning": ["negative_text", 0], "reference_latents_method": "index_timestep_zero"}},
+        "latent": {"class_type": "EmptySD3LatentImage", "inputs": {"width": width, "height": height, "batch_size": 1}},
+        "sampler": {"class_type": "KSampler", "inputs": {
+            "model": ["norm", 0], "positive": ["positive", 0], "negative": ["negative", 0],
+            "latent_image": ["latent", 0], "seed": seed % (2**63 - 1), "steps": 4, "cfg": 1.0,
+            "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0}},
+        "decode": {"class_type": "VAEDecode", "inputs": {"samples": ["sampler", 0], "vae": ["vae", 0]}},
+        "save": {"class_type": "SaveImage", "inputs": {"images": ["decode", 0], "filename_prefix": prefix}},
+    }
+    for index, name in enumerate(reference_names[:QWEN_EDIT_MAX_REFERENCES], start=1):
+        graph[f"reference_{index}"] = {"class_type": "LoadImage", "inputs": {"image": name}}
+        for text in ("positive_text", "negative_text"):
+            graph[text]["inputs"][f"image{index}"] = [f"reference_{index}", 0]
+    return graph
+
+
+def generate_edit_keyframe(server: str, prompt: str, aspect: str, seed: int, run_root: Path,
+                           timeout_seconds: float, references: list[Path]) -> Path:
+    required = (
+        COMFY_DIR / "models" / "diffusion_models" / QWEN_EDIT_DIFFUSION_MODEL,
+        COMFY_DIR / "models" / "text_encoders" / QWEN_EDIT_TEXT_ENCODER,
+        COMFY_DIR / "models" / "vae" / QWEN_EDIT_VAE,
+        COMFY_DIR / "models" / "loras" / QWEN_EDIT_LIGHTNING_LORA,
+    )
+    missing = [path.name for path in required if not path.is_file() or path.stat().st_size == 0]
+    if missing:
+        raise VideoGenError(f"Qwen-Image-Edit-2511 models are not installed: {', '.join(missing)}")
+    if any(not path.is_file() or path.stat().st_size == 0 for path in references):
+        raise VideoGenError("A Qwen-Image-Edit reference image is missing.")
+    copied = [copy_reference(path) for path in references[:QWEN_EDIT_MAX_REFERENCES]]
+    prefix = f"{run_root.relative_to(OUTPUT_DIR).as_posix()}/keyframe/edit_keyframe"
+    graph = edit_keyframe_graph(prompt, aspect, seed, prefix, [name for name, _ in copied])
+    client_id = f"video-qwen-edit-{uuid.uuid4().hex}"
+    progress = LiveProgress(server, client_id, {node: str(value["class_type"]) for node, value in graph.items()},
+                            (25.0, 300.0))
+    width, height = KEYFRAME_DIMENSIONS[aspect]
+    print(f"Generating a {width}x{height} Qwen-Image-Edit-2511 frame...", flush=True)
+    print(f"  qwen-edit: {prompt}", flush=True)
+    progress.start()
+    try:
+        response = api_json(server, "/prompt", {"prompt": graph, "client_id": client_id}, timeout=30.0)
+        if response.get("error") or not response.get("prompt_id"):
+            raise VideoGenError(f"Qwen-Image-Edit-2511 submission failed: {response}")
+        progress.set_prompt_id(str(response["prompt_id"]))
+        return wait_for_image(server, response["prompt_id"], prefix, timeout_seconds, progress).resolve()
+    finally:
+        progress.stop()
+        free_comfy_memory(server)
 
 
