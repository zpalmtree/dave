+def continuous_camera_beat(shot: dict[str, Any], segment: dict[str, Any]) -> bool:
+    transition = shot.get("camera_transition")
+    if transition in {"continuous", "cut"}:
+        return transition == "continuous"
+    # Saved plans predate the explicit field. Respect their clear single-take
+    # camera constraints without treating every static angle as one shared shot.
+    cameras = " ".join(str(beat.get("camera", "")) for beat in segment["shots"])
+    return bool(re.search(
+        r"\b(?:no (?:camera )?cuts?|without cuts?|do not cut|unbroken (?:take|shot)|"
+        r"(?:single|one) (?:continuous )?(?:take|shot))\b", cameras, re.I))
 
 
